generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  organization  String?
  role          String         @default("USER") // USER | ADMIN
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  submissions   Submission[]
  bookings      HotelBooking[]
  ownedMeetings Meeting[]      @relation("MeetingOwner")
  staffMeetings MeetingStaff[]
  speakers      Speaker[]
  notifications Notification[]
  feedbacks     Feedback[]
  templates     MeetingTemplate[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// 全局站点兜底配置（当会议未单独配置时使用）
model SiteConfig {
  id           Int      @id @default(1)
  confName     String   @default("")
  confDate     String   @default("")
  confLocation String   @default("")
  logoUrl      String?
  heroImageUrl String?
  welcomeHtml  String   @default("")
  liveUrl      String?
  contactHtml  String   @default("")
  venueName    String   @default("")
  venueAddress String   @default("")
  venueLng     String   @default("")
  venueLat     String   @default("")
  footerHtml   String   @default("")
  updatedAt    DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  meetingId   String   @default("default-meeting")
  slug        String
  title       String
  contentHtml String   @default("")
  mode        String   @default("TEXT") // TEXT | IMAGE (一图流)
  imageUrl    String?
  updatedAt   DateTime @updatedAt
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, slug])
  @@index([meetingId])
}

model Notice {
  id          String   @id @default(cuid())
  meetingId   String   @default("default-meeting")
  title       String
  contentHtml String   @default("")
  mode        String   @default("TEXT") // TEXT | IMAGE (一图流)
  imageUrl    String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Meeting {
  id                   String   @id @default(cuid())
  title                String
  description          String   @default("")
  location             String   @default("")
  startDate            String   @default("")
  endDate              String   @default("")
  isDefault            Boolean  @default(false)
  requireApproval      Boolean  @default(false)
  registrationLimit    Int?
  opensAt              String?
  closesAt             String?
  requirePassword      Boolean  @default(false)
  registrationPassword String   @default("")
  requireRealName      Boolean  @default(true) // 关闭后未登录游客也可直接浏览会议首页及相关展示页面
  scheduleMode         String   @default("TEXT") // TEXT | IMAGE (一图流)
  scheduleImageUrl     String?
  // 会议级站点配置
  confDate             String   @default("")
  welcomeHtml          String   @default("")
  footerHtml           String   @default("")
  contactHtml          String   @default("")
  logoUrl              String?
  heroImageUrl         String?
  liveUrl              String?
  liveMultiButton      Boolean  @default(false)
  venueAddress         String   @default("")
  venueLng             String   @default("")
  venueLat             String   @default("")
  homeGridColumns      Int      @default(4)
  homeGridRounded      Boolean  @default(true)
  // 整体外观：留空时前台仍用默认底色，不配置即与改造前一致
  bgColor              String   @default("")
  bgImageUrl           String?
  bgOverlay            Int      @default(0) // 0-80，背景图上的白色蒙版透明度，保证文字可读
  ownerId              String?
  owner                User?    @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  registrations Registration[]
  bookings      HotelBooking[]
  submissions   Submission[]
  guests        Guest[]
  channels      Channel[]
  badgeTemplate BadgeTemplate?
  staff         MeetingStaff[]
  notices       Notice[]
  pages         Page[]
  speakers      Speaker[]
  sessions      Session[]
  hotels        Hotel[]
  albums        Album[]
  homeGridItems HomeGridItem[]
  liveStreams   LiveStream[]
  reportLinks   ReportLink[]
  notifications Notification[]
  contact       MeetingContact?
  feedbacks     Feedback[]
  mealSessions  MealSession[]

  @@index([isDefault])
}

model LiveStream {
  id          String   @id @default(cuid())
  meetingId   String
  name        String
  url         String
  coverImage  String?
  introImage  String?
  description String   @default("")
  time        String   @default("")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, sortOrder])
}

model HomeGridItem {
  id              String  @id @default(cuid())
  meetingId       String
  title           String
  href            String
  icon            String  @default("file")
  size            String  @default("SMALL") // SMALL | WIDE | TALL | LARGE
  backgroundImage String?
  sortOrder       Int     @default(0)
  isVisible       Boolean @default(true)
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, sortOrder])
}

model RegistrationType {
  id            String         @id @default(cuid())
  name          String
  fee           Int            @default(0)
  description   String         @default("")
  registrations Registration[]
}

model Registration {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  meetingId    String
  meeting      Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  typeId       String
  type         RegistrationType       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  channelId    String?
  fullName     String
  organization String                 @default("")
  title        String                 @default("")
  phone        String                 @default("")
  status       String                 @default("PENDING") // PENDING | APPROVED | REJECTED
  // 签到凭证与状态
  token        String                 @unique @default(uuid())
  checkedIn    Boolean                @default(false)
  checkedInAt  DateTime?
  checkinLogs  CheckinLog[]
  createdAt    DateTime               @default(now())
  reception    RegistrationReception?
  mealRedemptions MealRedemption[]

  @@unique([userId, meetingId])
  @@index([meetingId])
  @@index([channelId])
}

model CheckinLog {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedAt      DateTime     @default(now())
  byUserId       String? // 管理员操作时记录其 userId，自助签到为空
  method         String       @default("SCAN") // SCAN | MANUAL | SELF

  @@index([registrationId])
  @@index([checkedAt])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  authors   String
  abstract  String
  fileUrl   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model Speaker {
  id           String            @id @default(cuid())
  meetingId    String            @default("default-meeting")
  name         String
  title        String            @default("")
  organization String            @default("")
  bio          String            @default("")
  photoUrl     String?
  token        String?           @unique @default(uuid())
  invitedAt    DateTime?
  confirmed    Boolean           @default(false)
  confirmedAt  DateTime?
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions     SessionSpeaker[]
  materials    SpeakerMaterial[]
  meeting      Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId])
}

model Session {
  id        String            @id @default(cuid())
  meetingId String            @default("default-meeting")
  day       String // 日期 YYYY-MM-DD
  startTime String
  endTime   String
  room      String            @default("")
  title     String
  speakers  SessionSpeaker[]
  materials SpeakerMaterial[]
  meeting   Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model SessionSpeaker {
  sessionId String
  speakerId String
  role      String  @default("SPEAKER") // SPEAKER | MODERATOR
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId, role])
}

model SpeakerMaterial {
  id             String    @id @default(cuid())
  speakerId      String
  sessionId      String
  // OSS object key。文件为私有读，一律通过 /api/materials/[id]/file 鉴权后代理访问，
  // 不再对外暴露 fileUrl。fileUrl 仅保留作历史记录与回填来源。
  fileKey        String    @default("")
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String    @default("")
  isConfidential Boolean   @default(false) // 保密：仅上传讲者、管理员、汇报链接可见
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote     String    @default("")
  reviewedAt     DateTime?
  reviewedById   String?
  uploadedAt     DateTime  @default(now())
  speaker        Speaker   @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([speakerId])
  @@index([sessionId])
  @@index([status])
}

/// 现场汇报链接：凭 token + 密码进入会议章程页，可查看该会议全部已审核通过的材料（含保密）。
model ReportLink {
  id           String    @id @default(cuid())
  meetingId    String
  token        String    @unique @default(uuid())
  name         String    @default("")
  passwordHash String
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdById  String?
  createdAt    DateTime  @default(now())
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Hotel {
  id          String         @id @default(cuid())
  meetingId   String         @default("default-meeting")
  name        String
  description String         @default("")
  price       Int            @default(0)
  address     String         @default("")
  imageUrl    String?
  distance    String         @default("")
  bookings    HotelBooking[]
  meeting     Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model HotelBooking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  checkIn   String
  checkOut  String
  rooms     Int      @default(1)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model Album {
  id        String  @id @default(cuid())
  meetingId String  @default("default-meeting")
  title     String
  date      String  @default("")
  note      String  @default("")
  startTime String  @default("")
  endTime   String  @default("")
  coverUrl  String?
  photos    Photo[]
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Photo {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String   @default("")
  createdAt DateTime @default(now())
}

model Guest {
  id          String          @id @default(cuid())
  meetingId   String
  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  company     String          @default("")
  title       String          @default("")
  level       String          @default("NORMAL") // VIP | NORMAL | MEDIA
  avatarUrl   String?
  bio         String          @default("")
  token       String          @unique @default(uuid())
  confirmed   Boolean         @default(false)
  confirmedAt DateTime?
  note        String          @default("")
  seatInfo    String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  reception   GuestReception?

  @@index([meetingId])
  @@index([level])
}

model GuestReception {
  id             String   @id @default(cuid())
  guestId        String   @unique
  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  arriveMode     String   @default("") // 航班/高铁/自驾
  arriveNo       String   @default("")
  arriveTime     String   @default("")
  arrivePlace    String   @default("")
  departMode     String   @default("")
  departNo       String   @default("")
  departTime     String   @default("")
  hotelName      String   @default("")
  hotelRoom      String   @default("")
  hotelCheckIn   String   @default("")
  hotelCheckOut  String   @default("")
  carPlate       String   @default("")
  carDriver      String   @default("")
  carDriverPhone String   @default("")
  carContact     String   @default("")
  remark         String   @default("")
  updatedAt      DateTime @updatedAt
}

model RegistrationReception {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  arriveMode     String       @default("") // 航班/高铁/自驾
  arriveNo       String       @default("")
  arriveTime     String       @default("")
  arrivePlace    String       @default("")
  departMode     String       @default("")
  departNo       String       @default("")
  departTime     String       @default("")
  hotelName      String       @default("")
  hotelRoom      String       @default("")
  hotelCheckIn   String       @default("")
  hotelCheckOut  String       @default("")
  carPlate       String       @default("")
  carDriver      String       @default("")
  carDriverPhone String       @default("")
  carContact     String       @default("")
  remark         String       @default("")
  updatedAt      DateTime     @updatedAt
}

model BadgeTemplate {
  id               String   @id @default(cuid())
  meetingId        String   @unique
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  pageWidthMm      Int      @default(86)
  pageHeightMm     Int      @default(147)
  bgImageUrl       String?
  labelGapMm       Int      @default(2)
  nameX            Int      @default(43)
  nameY            Int      @default(52)
  nameSize         Int      @default(14)
  titleX           Int      @default(43)
  titleY           Int      @default(40)
  titleSize        Int      @default(14)
  companyX         Int      @default(43)
  companyY         Int      @default(28)
  companySize      Int      @default(14)
  qrX              Int      @default(43)
  qrY              Int      @default(92)
  qrSize           Int      @default(34)
  meetingTitleX    Int      @default(43)
  meetingTitleY    Int      @default(128)
  meetingTitleSize Int      @default(17)
  updatedAt        DateTime @updatedAt
}

model Channel {
  id        String         @id @default(cuid())
  meetingId String
  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  code      String
  name      String
  owner     String         @default("")
  note      String         @default("")
  createdAt DateTime       @default(now())
  visits    ChannelVisit[]

  @@unique([meetingId, code])
  @@index([meetingId])
}

model ChannelVisit {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ip        String?
  ua        String?
  sessionId String?
  visitedAt DateTime @default(now())

  @@index([channelId])
  @@index([sessionId])
}

/// 餐次。typeIds 为空数组表示所有参会类型可用，避免新增类型就要回头补配置
model MealSession {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  day       String
  slot      String // BREAKFAST | LUNCH | DINNER
  name      String   @default("")
  venue     String   @default("")
  startTime String   @default("")
  endTime   String   @default("")
  /// 限定可用的参会类型 id 数组；空数组 = 不限
  typeIds   Json
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions MealRedemption[]

  @@unique([meetingId, day, slot])
  @@index([meetingId])
}

/// 用餐核销记录。唯一约束是防重领的根本保障——并发扫码时应用层"先查再写"挡不住
model MealRedemption {
  id             String       @id @default(cuid())
  mealSessionId  String
  mealSession    MealSession  @relation(fields: [mealSessionId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  redeemedAt     DateTime     @default(now())
  byUserId       String?

  @@unique([mealSessionId, registrationId])
  @@index([registrationId])
}

/// 管理员另存的场景模板。内置六套写在 src/lib/meeting-templates.ts 常量里，不入库
model MeetingTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  bgColor     String   @default("")
  bgImageUrl  String?
  bgOverlay   Int      @default(0)
  gridColumns Int      @default(4)
  gridRounded Boolean  @default(true)
  /// 宫格入口数组。套用时逐条过 homeGridItemSchema，与手工编辑器同一套白名单
  items       Json
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

/// 会议的结构化联系方式与客服二维码。原有 contactHtml 富文本保留，展示在结构化信息下方
model MeetingContact {
  id         String   @id @default(cuid())
  meetingId  String   @unique
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  orgName    String   @default("")
  phone      String   @default("")
  phone2     String   @default("")
  email      String   @default("")
  wechatId   String   @default("")
  address    String   @default("")
  wecomQrUrl String?
  groupQrUrl String?
  mpQrUrl    String?
  wecomNote  String   @default("")
  groupNote  String   @default("")
  mpNote     String   @default("")
  updatedAt  DateTime @updatedAt
}

/// 用户反馈。userId 可空：会议关闭实名要求时游客也能提交，此时只能靠 contact 字段回访
model Feedback {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category    String    @default("OTHER") // BUG | SUGGESTION | CONSULT | COMPLAINT | OTHER
  content     String
  contact     String    @default("")
  imageUrl    String?
  status      String    @default("PENDING") // PENDING | RESOLVED
  reply       String    @default("")
  repliedAt   DateTime?
  repliedById String?
  createdAt   DateTime  @default(now())

  @@index([meetingId, status])
  @@index([userId])
}

/// 站内信：每个收件人一条，不依赖任何外部服务，必达且可回溯
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String?
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @default("")
  linkHref  String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([meetingId])
}

/// 邮件外发队列。审核接口只负责入队，实际发送由 cron 驱动并按退避策略重试
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String?
  toAddress      String
  subject        String
  bodyText       String
  bodyHtml       String    @default("")
  status         String    @default("PENDING") // PENDING | SENT | FAILED
  attempts       Int       @default(0)
  lastError      String    @default("")
  nextAttemptAt  DateTime  @default(now())
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
}

model MeetingStaff {
  meetingId String
  userId    String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@id([meetingId, userId])
}
